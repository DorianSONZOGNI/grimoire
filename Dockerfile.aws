# 1. Build de l'application Java avec Maven
FROM maven:3.9.6-eclipse-temurin-21 AS build
COPY . .
RUN mvn clean package -DskipTests

# 2. Lancement de l'application pour AWS Lambda
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
COPY --from=build /target/*.jar app.jar

# Adaptateur officiel AWS avec le tag latest
COPY --from=public.ecr.aws/awslabs/aws-lambda-web-adapter:latest /lambda-adapter /opt/extensions/lambda-adapter

ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]